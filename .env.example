# Aiven PostgreSQL connection string. Use the URL-encoded password from Aiven.
DATABASE_URL=postgresql+psycopg://avnadmin:YOUR_PASSWORD@YOUR_HOST:PORT/defaultdb?sslmode=require
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LIGHT_MODEL=openai/gpt-4.1-mini
OPENROUTER_HEAVY_MODEL=openai/gpt-4.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
